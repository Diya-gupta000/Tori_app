# MIGRATION_DATABASE_URL=
SYNTHESIS_TIMEOUT_MS=90000
SYNTHESIS_MAX_CONCURRENT=2
SYNTHESIS_USER_LIMIT=5
SYNTHESIS_TEAM_LIMIT=20
