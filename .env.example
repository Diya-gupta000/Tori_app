# Local template only. Real values go in ignored .env or Railway runtime variables.
NODE_ENV=development
PORT=3001
BASE_PATH=/
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://localhost:5432/tori_dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
